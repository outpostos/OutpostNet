# Generated by outpostnet-agent chrony render for node node-a (ADR-0006 D7).
# Re-render when the peer set or node certificate changes; do not edit.

# NTS server: this node authenticates NTP with its group certificate.
ntsservercert /credentials/node-a.pem
ntsserverkey /credentials/node-a.key
ntsdumpdir /var/lib/chrony
ntsport 4460

# Trust only the group CA for NTS peers; the system CA set is disabled.
nosystemcert
ntstrustedcerts 1 /credentials/group.pem

# Orphan mode: converge within the group without an external time source.
local stratum 10 orphan

# Step the clock on the first large correction (boot with a wrong clock).
makestep 1.0 3
# Accept NTS peer certificates before the first clock update.
nocerttimecheck 1

# NTP sources for node node-a (reload with `chronyc reload sources`).
# Group peers are served over NTS with the group CA set defined above.
# No group peers are configured.
