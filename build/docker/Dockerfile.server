# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X github.com/outpostos/OutpostNet/pkg/version.gitVersion=${VERSION} \
              -X github.com/outpostos/OutpostNet/pkg/version.gitCommit=${COMMIT} \
              -X github.com/outpostos/OutpostNet/pkg/version.buildDate=${BUILD_TIME}" \
    -o /outpostnet-server ./cmd/outpostnet-server

# Runtime stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /outpostnet-server /usr/local/bin/outpostnet-server

ENTRYPOINT ["outpostnet-server"]
