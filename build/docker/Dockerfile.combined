# Combined server+agent image for OutpostNet 1.0 core deployment.
# Binaries are pre-built by `make release` (CGO_ENABLED=0, linux/amd64).
# Build context: build/release/docker-stage (set by make docker-build-combined)
FROM debian:bookworm-slim

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown

LABEL org.opencontainers.image.title="OutpostNet" \
      org.opencontainers.image.description="OutpostNet server and agent — edge tunnel core" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY outpostnet-server /usr/local/bin/outpostnet-server
COPY outpostnet-agent  /usr/local/bin/outpostnet-agent

RUN chmod +x /usr/local/bin/outpostnet-server /usr/local/bin/outpostnet-agent

# Default to server; override CMD to run agent
ENTRYPOINT ["outpostnet-server"]
